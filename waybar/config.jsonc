{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "output": "HDMI-A-1",
    "modules-left": [
        "hyprland/workspaces",
        "custom/sep-left",
        "hyprland/window"
    ],
    "modules-center": [],
    "modules-right": [
        "pulseaudio",
        "custom/sep-vol",
        "memory",
        "custom/sep-ram",
        "cpu",
        "custom/sep-cpu",
        "custom/clock"
    ],
    "hyprland/workspaces": {
        "format": "{name}",
        "all-outputs": true,
        "on-click": "activate"
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 30
    },
    "custom/sep-left": {
        "format": "|",
        "tooltip": false
    },
    "custom/sep-vol": {
        "format": "|",
        "tooltip": false
    },
    "custom/sep-ram": {
        "format": "|",
        "tooltip": false
    },
    "custom/sep-cpu": {
        "format": "|",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "<span color='#6c7791'>VOL</span> {volume}%",
        "format-muted": "muted",
        "tooltip-format": "{desc} ({volume}%)",
        "on-click": "pavucontrol"
    },
    "memory": {
        "interval": 2,
        "format": "<span color='#6c7791'>RAM</span> {percentage}%",
        "tooltip-format": "{used:0.1f}GiB / {total:0.1f}GiB"
    },
    "cpu": {
        "interval": 2,
        "format": "<span color='#6c7791'>CPU</span> {usage}%",
        "tooltip": false
    },
    "custom/clock": {
        "exec": "$HOME/.config/waybar/clock.sh",
        "interval": 1,
        "format": "{}",
        "tooltip": false
    }
}
